#!/usr/bin/env python3
"""
Bridge vision_benchmark pose output to docking controller PoseStamped input.

Subscribes: std_msgs/Float64MultiArray [x, y, z, q1, q2, q3, q4] (URSO / thesis format)
Publishes: geometry_msgs/PoseStamped (q4 = scalar per URSO JPL convention)

Optional EMA on position reduces steppy control when vision updates are sparse/noisy
(FoundationPose typically publishes smoother PoseStamped directly).
"""

from typing import Optional

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy
from std_msgs.msg import Float64MultiArray
from geometry_msgs.msg import PoseStamped
import numpy as np


class PoseArrayBridgeNode(Node):
    def __init__(self):
        super().__init__('pose_array_bridge_node')

        self.declare_parameter('input_topic', '/vision_benchmark/pose_xyz_quat')
        self.declare_parameter('output_topic', '/pose_estimation/object_pose')
        self.declare_parameter('frame_id', 'camera_optical_frame')
        self.declare_parameter('scale_xyz', [1.0, 1.0, 1.0])
        self.declare_parameter('invert_xyz', [1.0, 1.0, 1.0])
        self.declare_parameter('quat_scalar_first', False)
        # EMA: smoothed = alpha * raw + (1-alpha) * smoothed. Lower alpha = smoother.
        self.declare_parameter('enable_position_smoothing', True)
        self.declare_parameter('position_smoothing_alpha', 0.35)

        self._input_topic = self.get_parameter('input_topic').value
        self._output_topic = self.get_parameter('output_topic').value
        self._frame_id = self.get_parameter('frame_id').value
        self._scale = list(self.get_parameter('scale_xyz').value)
        self._invert = list(self.get_parameter('invert_xyz').value)
        self._quat_scalar_first = self.get_parameter('quat_scalar_first').value
        self._smooth_pos = self.get_parameter('enable_position_smoothing').value
        self._alpha = float(self.get_parameter('position_smoothing_alpha').value)
        self._alpha = float(np.clip(self._alpha, 0.01, 1.0))

        self._filt_pos: Optional[np.ndarray] = None

        qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            history=HistoryPolicy.KEEP_LAST,
            depth=10,
        )

        self._pub = self.create_publisher(PoseStamped, self._output_topic, 10)
        self._sub = self.create_subscription(
            Float64MultiArray,
            self._input_topic,
            self._callback,
            qos,
        )

        smooth_msg = (
            f'position EMA alpha={self._alpha}'
            if self._smooth_pos
            else 'no position smoothing'
        )
        self.get_logger().info(
            f'Bridging {self._input_topic} -> {self._output_topic} ({smooth_msg})'
        )

    def _smooth_position(self, raw: np.ndarray) -> np.ndarray:
        if not self._smooth_pos:
            return raw
        if self._filt_pos is None:
            self._filt_pos = raw.copy()
            return raw
        self._filt_pos = self._alpha * raw + (1.0 - self._alpha) * self._filt_pos
        return self._filt_pos.copy()

    def _callback(self, msg: Float64MultiArray):
        if len(msg.data) < 7:
            self.get_logger().warn(
                f'Expected 7 pose values, got {len(msg.data)}',
                throttle_duration_sec=2.0,
            )
            return

        raw = np.array([
            float(msg.data[0]) * self._scale[0] * self._invert[0],
            float(msg.data[1]) * self._scale[1] * self._invert[1],
            float(msg.data[2]) * self._scale[2] * self._invert[2],
        ])
        pos = self._smooth_position(raw)
        q1, q2, q3, q4 = (float(msg.data[3]), float(msg.data[4]),
                          float(msg.data[5]), float(msg.data[6]))

        out = PoseStamped()
        out.header.stamp = self.get_clock().now().to_msg()
        out.header.frame_id = self._frame_id
        out.pose.position.x = float(pos[0])
        out.pose.position.y = float(pos[1])
        out.pose.position.z = float(pos[2])

        if self._quat_scalar_first:
            out.pose.orientation.w = q1
            out.pose.orientation.x = q2
            out.pose.orientation.y = q3
            out.pose.orientation.z = q4
        else:
            out.pose.orientation.x = q1
            out.pose.orientation.y = q2
            out.pose.orientation.z = q3
            out.pose.orientation.w = q4

        self._pub.publish(out)


def main(args=None):
    rclpy.init(args=args)
    node = PoseArrayBridgeNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
